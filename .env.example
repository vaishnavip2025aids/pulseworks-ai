# Copy this file to .env and adjust. Only variables prefixed with VITE_ reach the browser.
# NEVER put secrets (API keys, DB passwords, JWT secrets) in VITE_ variables.

# Display name of the app
VITE_APP_NAME=PulseWorks AI

# development | staging | production
VITE_APP_ENV=development

# Base URL of the backend API (used from Day 3 onward)
VITE_API_BASE_URL=http://localhost:4000/api

# Optional: endpoint returning [{ "id": "...", "level": "info|warning|critical", "message": "..." }]
# Leave empty to use the built-in mock status feed.
VITE_STATUS_ENDPOINT=

# How often the system banner refreshes / rotates (milliseconds)
VITE_STATUS_POLL_MS=8000

# External API consumed by the "Import sample tasks" action and the Settings connection check.
# Must be https (http allowed only for localhost). Public, read-only data only; no keys in the browser.
VITE_EXTERNAL_API_URL=https://jsonplaceholder.typicode.com
VITE_API_TIMEOUT_MS=8000
